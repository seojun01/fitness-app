{
  "name": "fitness-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "개인용 운동 기록 앱 — 홈서버 동기화, 오프라인 우선 PWA",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/build.mjs && FITNESS_DEV=1 node server/src/main.ts",
    "build": "node scripts/build.mjs",
    "test": "node --test \"shared/tests/**/*.test.ts\" \"server/tests/**/*.test.ts\" \"client/tests/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && node scripts/lint.mjs"
  },
  "bin": {
    "fitness-admin": "server/src/admin-cli.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.9.3"
  }
}
