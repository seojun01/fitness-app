# systemd 유닛: 운동 기록 앱 서버. 설치 위치: /etc/systemd/system/fitness.service (deploy/install.sh 가 복사한다)
[Unit]
Description=Fitness app server (sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fitness
Group=fitness
WorkingDirectory=/opt/fitness
ExecStart=/usr/bin/node /opt/fitness/server/src/main.ts
Environment=HOST=127.0.0.1
# todo-app 이 8080 을 쓰므로 같은 호스트에서도 겹치지 않게 8081 을 쓴다
Environment=PORT=8081
Environment=FITNESS_DB=/var/lib/fitness/fitness.db
# 휴식 알림(웹 푸시) 서명 키. 처음 실행할 때 만들어진다
Environment=FITNESS_VAPID_FILE=/var/lib/fitness/vapid.json
# node:sqlite 의 "experimental" 경고를 로그에서 줄인다
Environment=NODE_NO_WARNINGS=1
Restart=on-failure
RestartSec=3

# 쓸 수 있는 곳은 /var/lib/fitness 뿐이다
StateDirectory=fitness
StateDirectoryMode=0750
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# 휴식 알림을 보내려면 푸시 서비스(Apple·Google·Mozilla)로 나가는 HTTPS 가 필요하다.
# 보내는 곳은 코드의 허용 목록(webpush.ts)으로 제한한다 (임의 주소로 요청하지 않는다).

[Install]
WantedBy=multi-user.target
